# Merge over Linux tinyconfig; single hart RV64IMA, S-mode Sv39, no C/F/D.
CONFIG_ARCH_RV64I=y
# Portable Linux selects EFI, which forces the C extension; our fixed RV64IMA
# platform deliberately uses the upstream NONPORTABLE configuration instead.
CONFIG_NONPORTABLE=y
CONFIG_MMU=y
# CONFIG_SMP is not set
# CONFIG_FPU is not set
# CONFIG_RISCV_ISA_C is not set
# CONFIG_RISCV_ISA_V is not set
# CONFIG_RISCV_ISA_SVPBMT is not set
# CONFIG_RISCV_ISA_SVNAPOT is not set
# CONFIG_RISCV_ISA_ZICBOM is not set
# CONFIG_RISCV_ISA_ZICBOZ is not set
# CONFIG_MODULES is not set
# CONFIG_RANDOMIZE_BASE is not set
# CONFIG_BLOCK is not set
# CONFIG_NET is not set
# CONFIG_EFI is not set
CONFIG_EXPERT=y
CONFIG_MULTIUSER=y
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_ELF_CORE=y
CONFIG_FUTEX=y
CONFIG_POSIX_TIMERS=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_COMPRESSION_NONE=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_TTY=y
# CONFIG_VT is not set
# CONFIG_VGA_CONSOLE is not set
# CONFIG_INPUT is not set
# CONFIG_HID is not set
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=1
CONFIG_SERIAL_8250_RUNTIME_UARTS=1
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_SHMEM=y
CONFIG_TMPFS=y
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_SYSCON=y
CONFIG_POWER_RESET_SYSCON_POWEROFF=y
CONFIG_HZ_100=y
CONFIG_LOCALVERSION="-rv64lab"
CONFIG_DEFAULT_HOSTNAME="rv64lab"
