# Minimal interactive RV64IMA initramfs; merge over upstream allnoconfig.
CONFIG_BUSYBOX=y
CONFIG_STATIC=y
CONFIG_STATIC_LIBGCC=y
CONFIG_LONG_OPTS=y
CONFIG_LFS=y
CONFIG_DESKTOP=y
CONFIG_SHOW_USAGE=y
CONFIG_FEATURE_VERBOSE_USAGE=y
CONFIG_FEATURE_EDITING=y
CONFIG_FEATURE_EDITING_MAX_LEN=1024
CONFIG_FEATURE_EDITING_HISTORY=32
CONFIG_FEATURE_TAB_COMPLETION=y
CONFIG_ASH=y
CONFIG_SH_IS_ASH=y
# CONFIG_SH_IS_NONE is not set
CONFIG_ASH_OPTIMIZE_FOR_SIZE=y
CONFIG_ASH_JOB_CONTROL=y
CONFIG_ASH_ALIAS=y
CONFIG_ASH_ECHO=y
CONFIG_ASH_PRINTF=y
CONFIG_ASH_TEST=y
CONFIG_ASH_GETOPTS=y
CONFIG_FEATURE_SH_MATH=y
CONFIG_FEATURE_SH_MATH_64=y
CONFIG_INIT=y
CONFIG_FEATURE_USE_INITTAB=y
CONFIG_FEATURE_INIT_SCTTY=y
CONFIG_FEATURE_INIT_QUIET=y
CONFIG_HALT=y
CONFIG_POWEROFF=y
CONFIG_REBOOT=y
CONFIG_MOUNT=y
CONFIG_UMOUNT=y
CONFIG_FEATURE_UMOUNT_ALL=y
CONFIG_ID=y
CONFIG_TTY=y
CONFIG_CAT=y
CONFIG_CP=y
CONFIG_DD=y
CONFIG_ECHO=y
CONFIG_ENV=y
CONFIG_FALSE=y
CONFIG_TRUE=y
CONFIG_FREE=y
CONFIG_HEAD=y
CONFIG_HEXDUMP=y
CONFIG_KILL=y
CONFIG_LN=y
CONFIG_LS=y
CONFIG_MKDIR=y
CONFIG_MV=y
CONFIG_PRINTF=y
CONFIG_PS=y
CONFIG_PWD=y
CONFIG_RM=y
CONFIG_SLEEP=y
CONFIG_TAIL=y
CONFIG_TEST=y
CONFIG_TOUCH=y
CONFIG_UNAME=y
CONFIG_UPTIME=y
CONFIG_WC=y
CONFIG_DMESG=y
CONFIG_GREP=y
CONFIG_SED=y
